# ============================================================
# llama.cpp — image d'inférence locale (Gemma 4 E2B + E4B)
# Build avec CUDA + Flash Attention. Modèles montés en volume.
# NOTE : il faut cibler l'archi CUDA de la GPU hôte (sm86 pour
# RTX 3050 laptop / Ampere 8.6). Build de PRODUCTION : docker build.
# ============================================================
FROM nvidia/cuda:12.4.0-devel-ubuntu22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
ARG LLAMACPP_TAG=master
ARG CUDA_ARCHS="86"
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake build-essential ninja-build && \
    rm -rf /var/lib/apt/lists/*

# ---- Build llama.cpp ----
WORKDIR /src
RUN git clone --depth 1 --branch $LLAMACPP_TAG https://github.com/ggml-org/llama.cpp.git . \
    || git clone --depth 1 https://github.com/ggml-org/llama.cpp.git .
RUN mkdir build && cd build && \
    cmake .. \
      -DGGML_CUDA=ON \
      -DGGML_CUDA_FA=ON \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES="$CUDA_ARCHS" \
      -DLLAMA_SERVER=ON -DLLAMA_BUILD_EXAMPLES=ON && \
    cmake --build . --config Release -j$(nproc) --target llama-server llama-cli llama-embedding

# ============================================================
# Image runtime minimale
# ============================================================
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /src/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=build /src/build/bin/llama-cli     /usr/local/bin/llama-cli
COPY --from=build /src/build/bin/llama-embedding /usr/local/bin/llama-embedding

# Répertoires montés depuis l'hôte
RUN mkdir -p /models /presets && chmod 777 /models /presets

WORKDIR /workspace
EXPOSE 8080 8081

ENTRYPOINT ["/usr/local/bin/llama-server"]