; MARÉE — client de visualisation
;
; Consommateur pur (décision 9) : il ne calcule rien, il dessine ce que
; le journal lui envoie. Le plan vient du message `hello`, pas d'une
; copie en GDScript — c'était le défaut de la v1.
;
; Rendu GL Compatibility : pas de Vulkan, tourne en VM et en container.

config_version=5

[application]

config/name="MARÉE — Port-Aubel"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1000
window/size/viewport_height=640
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
