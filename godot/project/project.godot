; Engine configuration file — Godot 4.x
; Godot est un consommateur pur du flux (décision 9) : aucune logique de
; simulation, il ne fait qu'afficher les événements reçus de python-sim.

config_version=5

[application]
config/name="MAREE Visualisation"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("")
config/icon="res://icon.svg"

[gui]
theme/custom=""
theme/default_font=""
theme/icon_font=""

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="forward_plus"
renderer/antialiasing=1
environment/defaults/main_canvas_item_size=Vector2i(1280, 800)

[input_devices]
pointing/emulate_touch_from_mouse=false

[network]
network/tls/enabled=true
debug/remote_port=8765