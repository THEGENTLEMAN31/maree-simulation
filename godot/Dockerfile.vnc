# ============================================================
# Godot VNC — démo jury dans le navigateur (noVNC :6080).
# Xvfb + fluxbox + x11vnc + websockify, gérés par supervisord.
# ============================================================
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

ARG GODOT_URL=https://github.com/godotengine/godot/releases/download/4.4.1-stable/Godot_v4.4.1-stable_linux.x86_64.zip

RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip curl ca-certificates xvfb x11vnc fluxbox novnc websockify supervisor \
    libglib2.0-0 libpcre2-8-0 xauth \
    libgl1 libglx-mesa0 libegl1 libgles2 mesa-utils \
    libxcursor1 libxinerama1 libxrandr2 libxi6 libxext6 libxrender1 \
    libasound2 libfontconfig1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -L --fail -o /tmp/godot.zip "$GODOT_URL" \
    && unzip -o /tmp/godot.zip -d /opt/godot \
    && rm /tmp/godot.zip \
    && chmod +x /opt/godot/Godot_v4.4.1-stable_linux.x86_64 \
    && ln -s /opt/godot/Godot_v4.4.1-stable_linux.x86_64 /usr/local/bin/godot

WORKDIR /godot
COPY project/ ./project/
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

ENV DISPLAY=:0
ENV SIM_WS_URL=ws://python-sim:8765
ENV GODOT_FLAGS=""

EXPOSE 5900 6080

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]