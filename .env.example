# ============================================================
# MARÉE — variables d'environnement (copier vers .env)
# ============================================================

# --- Infra réseau ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
REDPANDA_ADMIN_ADDR=redpanda:9644

# --- LLM Gateway (llama.cpp router) ---
LLM_BASE_URL=http://llama-cpp:8080/v1
LLM_MODEL_FAST=gemma4-e2b
LLM_MODEL_BIG=gemma4-e4b
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2
LLM_FALLBACK_TO_RULES=true

# --- Godot / WebSocket ---
SIM_WS_HOST=0.0.0.0
SIM_WS_PORT=8765
SIM_WS_TOKEN=demo_token

# --- RAG ---
RAG_DB_PATH=/data/rag
RAG_EMBEDDING_URL=http://llama-cpp:8081/v1
RAG_EMBEDDING_MODEL=bge-small-en-v1.5
RAG_TOP_K=5
RAG_OVER_RETRIEVE=3

# --- Simulation ---
SIM_CONFIG=/config/simulation.yaml
WORLD_CORPUS_PATH=/world_corpus

# --- GPU / inference ---
NVIDIA_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0
OLLAMA_HOST_OBSERVABLE=ollama:11434   # Ollama hôte non touché (hors Docker)